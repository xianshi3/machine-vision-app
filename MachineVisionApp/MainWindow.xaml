<Window x:Class="MachineVisionApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MachineVisionApp"
        xmlns:views="clr-namespace:MachineVisionApp.Views"
        Title="{Binding Source={x:Static local:TranslationService.Instance}, Path=AppTitle}"
        Height="760" Width="1120"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True"
        Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ====== Title Bar ====== -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <views:CustomTitleBar/>
        </Border>

        <!-- ====== Main Content ====== -->
        <Grid Grid.Row="1" Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ====== Left: Original Stream Card ====== -->
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ImageCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Style="{StaticResource ImageCardHeaderStyle}">
                        <Grid Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Source={x:Static local:TranslationService.Instance}, Path=OriginalStream}"
                                       FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="CameraDataTextBlock"
                                       Style="{StaticResource ValueStyle}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                    </Border>

                    <!-- Image area -->
                    <Border Grid.Row="1" Background="{StaticResource BgBrush}" Margin="0" BorderThickness="0">
                        <Grid>
                            <Image x:Name="OriginalImage" Stretch="Uniform" Margin="6"/>
                            <Border x:Name="EmptyOverlayLeft" Background="{StaticResource BgBrush}" Visibility="Visible">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Ellipse Width="48" Height="48" Fill="{StaticResource CardBrush}" Margin="0,0,0,12"/>
                                    <TextBlock Text="No Signal" Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="14" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="SourceInfoText" Text="{Binding Source={x:Static local:TranslationService.Instance}, Path=CameraWaiting}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Footer -->
                    <Border Grid.Row="2" Style="{StaticResource ImageCardFooterStyle}" Padding="14,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ConnectionIndicator" Width="6" Height="6" Fill="{StaticResource TextMutedBrush}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Source={x:Static local:TranslationService.Instance}, Path=StatusDisconnected}"
                                       x:Name="StatusTextFooter"
                                       Style="{StaticResource LabelStyle}" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ====== Right: Edge Detection Card ====== -->
            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource ImageCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Style="{StaticResource ImageCardHeaderStyle}">
                        <Grid Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Source={x:Static local:TranslationService.Instance}, Path=EdgeDetection}"
                                       FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Source={x:Static local:TranslationService.Instance}, Path=Faces}"
                                           Style="{StaticResource LabelStyle}" FontSize="11" Margin="0,0,4,0"/>
                                <TextBlock x:Name="FaceCountTextBlock" Text="0" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Image area -->
                    <Border Grid.Row="1" Background="{StaticResource BgBrush}" Margin="0" BorderThickness="0">
                        <Grid>
                            <Image x:Name="EdgeImage" Stretch="Uniform" Margin="6"/>
                            <Border x:Name="EmptyOverlayRight" Background="{StaticResource BgBrush}" Visibility="Visible">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Ellipse Width="48" Height="48" Fill="{StaticResource CardBrush}" Margin="0,0,0,12"/>
                                    <TextBlock Text="No Data" Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="14" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Footer -->
                    <Border Grid.Row="2" Style="{StaticResource ImageCardFooterStyle}" Padding="14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Threshold:" Style="{StaticResource LabelStyle}" FontSize="11"/>
                            <TextBlock x:Name="ThresholdInfoText" Text="100 ~ 200" Style="{StaticResource ValueStyle}"
                                       FontSize="11" FontWeight="Normal" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ====== Bottom Control Panel ====== -->
            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource ImageCardStyle}"
                    Padding="0" Margin="0,16,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="48"/>
                    </Grid.RowDefinitions>

                    <!-- ====== Row 1: Connection ====== -->
                    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="10,10,0,0"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,0">
                        <Grid Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Source type -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Source={x:Static local:TranslationService.Instance}, Path=SourceType}"
                                           Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
                                <ComboBox x:Name="SourceTypeComboBox" Width="130" SelectedIndex="0"
                                          Style="{StaticResource ComboBoxStyle}"
                                          SelectionChanged="SourceTypeComboBox_SelectionChanged"/>
                            </StackPanel>

                            <Rectangle Grid.Column="1" Style="{StaticResource DividerVStyle}" Margin="16,0"/>

                            <!-- Network config -->
                            <StackPanel Grid.Column="2" x:Name="NetworkConfigPanel" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="False">
                                <TextBlock Text="{Binding Source={x:Static local:TranslationService.Instance}, Path=IPAddress}"
                                           Style="{StaticResource LabelStyle}" Margin="0,0,6,0"/>
                                <Border Background="{StaticResource InputBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Margin="0,0,8,0">
                                    <TextBox x:Name="IPTextBox" Text="192.168.1.100" Width="135"
                                             Style="{StaticResource TextBoxStyle}" BorderThickness="0" Padding="8,5"/>
                                </Border>
                                <TextBlock Text=":" Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" FontSize="14" FontWeight="Bold"/>
                                <Border Background="{StaticResource InputBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Margin="0,0,8,0">
                                    <TextBox x:Name="PortTextBox" Text="8080" Width="65"
                                             Style="{StaticResource TextBoxStyle}" BorderThickness="0" Padding="8,5"/>
                                </Border>
                                <TextBlock Text="{Binding Source={x:Static local:TranslationService.Instance}, Path=RTSPHint}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="10"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                            </StackPanel>

                            <!-- Connect/Disconnect -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ConnectButton"
                                        Content="{Binding Source={x:Static local:TranslationService.Instance}, Path=Connect}"
                                        Style="{StaticResource PrimaryButtonStyle}" Padding="16,6" FontSize="12"
                                        Click="ConnectButton_Click"/>
                                <Button x:Name="DisconnectButton"
                                        Content="{Binding Source={x:Static local:TranslationService.Instance}, Path=Disconnect}"
                                        Style="{StaticResource DangerButtonStyle}" Padding="16,6" FontSize="12"
                                        Margin="6,0,0,0" IsEnabled="False"
                                        Click="DisconnectButton_Click"/>
                            </StackPanel>

                            <!-- Status -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Ellipse x:Name="StatusIndicator" Width="8" Height="8"
                                         Fill="{StaticResource TextMutedBrush}"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="StatusText" Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Error -->
                            <Border Grid.Column="7" x:Name="ErrorBorder" Visibility="Collapsed"
                                    Background="{StaticResource DangerDimBrush}" BorderBrush="{StaticResource DangerBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center"
                                    MaxWidth="280">
                                <TextBlock x:Name="ErrorMessageTextBlock" Text="" FontSize="11"
                                           Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Divider -->
                    <Rectangle Grid.Row="1" Fill="{StaticResource BorderBrush}"/>

                    <!-- ====== Row 2: Processing Controls ====== -->
                    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="0,0,10,10">
                        <Grid Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Canny Threshold -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Source={x:Static local:TranslationService.Instance}, Path=CannyThreshold}"
                                           Style="{StaticResource LabelStyle}" Margin="0,0,10,0"/>
                                <Border Background="{StaticResource InputBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Margin="0,0,6,0">
                                    <TextBox x:Name="Threshold1TextBox" Text="100" Width="55"
                                             Style="{StaticResource TextBoxStyle}" BorderThickness="0" Padding="8,5"/>
                                </Border>
                                <TextBlock Text="{Binding Source={x:Static local:TranslationService.Instance}, Path=ThresholdSeparator}"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Border Background="{StaticResource InputBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Margin="0,0,8,0">
                                    <TextBox x:Name="Threshold2TextBox" Text="200" Width="55"
                                             Style="{StaticResource TextBoxStyle}" BorderThickness="0" Padding="8,5"/>
                                </Border>
                                <Button x:Name="ApplyThresholdsButton"
                                        Content="{Binding Source={x:Static local:TranslationService.Instance}, Path=Apply}"
                                        Style="{StaticResource PrimaryButtonStyle}" Padding="14,6" FontSize="12"/>
                            </StackPanel>

                            <!-- Divider -->
                            <Rectangle Grid.Column="1" Style="{StaticResource DividerVStyle}" Margin="16,0"/>

                            <!-- Action Buttons -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="StartCameraButton"
                                        Content="{Binding Source={x:Static local:TranslationService.Instance}, Path=StartCamera}"
                                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0" Padding="16,8"
                                        Click="StartCameraButton_Click"/>
                                <Button x:Name="StopCameraButton"
                                        Content="{Binding Source={x:Static local:TranslationService.Instance}, Path=StopCamera}"
                                        Style="{StaticResource DangerButtonStyle}" Margin="0,0,6,0" Padding="16,8"
                                        IsEnabled="False" Click="StopCameraButton_Click"/>
                                <Button x:Name="LoadImageButton"
                                        Content="{Binding Source={x:Static local:TranslationService.Instance}, Path=LoadImage}"
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="16,8"
                                        Click="LoadImageButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
