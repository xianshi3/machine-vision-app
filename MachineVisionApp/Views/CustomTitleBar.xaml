<UserControl x:Class="MachineVisionApp.Views.CustomTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MachineVisionApp"
             mc:Ignorable="d" 
             d:DesignHeight="48" d:DesignWidth="1100"
             Height="48">
    <Grid Background="#161B22" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Grid.Column="0">
            <Border Background="#21262D" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                <TextBlock Text="MV" FontSize="12" FontWeight="Bold" Foreground="#58A6FF"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="{Binding Source={x:Static local:TranslationService.Instance}, Path=MachineVision}"
                       FontSize="15" FontWeight="SemiBold" Foreground="#C9D1D9" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Grid.Column="2">
            <!-- Language Switch -->
            <Button x:Name="LanguageSwitchButton"
                    Style="{StaticResource TitleBarButtonStyle}"
                    Content="中/EN"
                    Click="LanguageSwitchButton_Click"
                    ToolTip="Switch Language"
                    FontSize="12"
                    Width="48" Height="32"/>

            <Button x:Name="MinimizeButton"
                    Style="{StaticResource TitleBarButtonStyle}"
                    Content="&#xE921;"
                    Click="MinimizeButton_Click"
                    ToolTip="{Binding Source={x:Static local:TranslationService.Instance}, Path=Minimize}"
                    FontFamily="Segoe MDL2 Assets"
                    Width="46" Height="32"/>
            <Button x:Name="MaximizeButton"
                    Style="{StaticResource TitleBarButtonStyle}"
                    Content="&#xE922;"
                    Click="MaximizeButton_Click"
                    ToolTip="{Binding Source={x:Static local:TranslationService.Instance}, Path=Maximize}"
                    FontFamily="Segoe MDL2 Assets"
                    Width="46" Height="32"/>
            <Button x:Name="CloseButton"
                    Style="{StaticResource TitleBarButtonStyle}"
                    Content="&#xE8BB;"
                    Click="CloseButton_Click"
                    ToolTip="{Binding Source={x:Static local:TranslationService.Instance}, Path=Close}"
                    FontFamily="Segoe MDL2 Assets"
                    Width="46" Height="32">
                <Button.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F85149"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
